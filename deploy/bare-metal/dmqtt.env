# DMQTT Broker Environment Configuration
# Uncomment and modify values as needed.
# The broker uses built-in defaults for any variable not set here.

# MQTT TCP listen address
# DMQTT_TCP_ADDR=:1883

# MQTT TLS listen address (empty = TLS disabled)
# DMQTT_TLS_ADDR=:8883
# DMQTT_TLS_CERT=/opt/dmqtt/certs/server.crt
# DMQTT_TLS_KEY=/opt/dmqtt/certs/server.key

# WebSocket listen address (empty = disabled)
# DMQTT_WS_ADDR=:8083

# HTTP API listen address (metrics, health, device management)
# DMQTT_HTTP_ADDR=:9090

# Pebble data directory (empty = in-memory only, no persistence)
# DMQTT_DATA_DIR=/opt/dmqtt/data

# Authentication credentials file (empty = no auth)
# DMQTT_AUTH_FILE=/etc/dmqtt/auth.json

# Log level: debug, info, warn, error
# DMQTT_LOG_LEVEL=info